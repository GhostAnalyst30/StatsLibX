an of all numeric columns or a specific column.","parameters":[{"name":"column","type":"str | None","description":"Column name. If None, computes mean for all numeric columns.","default":"None"}],"returns":"float | pd.Series","example":"import pandas as pd\nfrom statslibx import DescriptiveStats\n\ndf = pd.DataFrame({\"A\": [1, 2, 3, 4, 5], \"B\": [10, 20, 30, 40, 50]})\nds = DescriptiveStats(df)\n\n# Mean of a specific column\nmean_a = ds.mean(\"A\")  # 3.0\n\n# Mean of all numeric columns\nmeans = ds.mean()\nprint(means)"}],"$L10","$L11","$L12","$L13","$L14","$L15","$L16","$L17","$L18","$L19","$L1a","$L1b","$L1c","$L1d","$L1e","$L1f","$L20","$L21","$L22","$L23","$L24"]}]]}],"$L25","$L26"],null,"$L27"]}]
