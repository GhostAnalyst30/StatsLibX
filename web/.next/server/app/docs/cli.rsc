18:["$","section",null,{"className":"mb-12","children":[["$","h2",null,{"className":"section-title","children":"Installation Verification"}],["$","p",null,{"className":"text-sm text-muted leading-relaxed mb-4","children":"Confirm that StatsLibX is installed correctly and the CLI is on your PATH by running the welcome message:"}],["$","$L20",null,{"title":"Verify installation","code":"statslibx\n\n# Output:\n# ╔══════════════════════════════════════════════╗\n# ║         Welcome to StatsLibX v0.2.9       ║\n# ║   Statistical Analysis for Data Science    ║\n# ╚══════════════════════════════════════════════╝\n#\n# Available commands:\n#   describe    Descriptive statistics\n#   quality     Data quality report\n#   preview     Data preview\n#   info        Complete dataset information\n#   data        Dataset summary\n#\n# Run 'statslibx <command> --help' for detailed usage."}],["$","p",null,{"className":"text-sm text-muted leading-relaxed mt-4","children":"If you see the welcome banner above, you are ready to start analysing data from the terminal. The version number matches the installed Python package."}]]}]
19:["$","section",null,{"className":"mb-12","children":[["$","h2",null,{"className":"section-title","children":"Example Workflows"}],["$","h3",null,{"className":"font-syne text-sm font-semibold text-white mb-3","children":"Quick data exploration"}],["$","p",null,{"className":"text-sm text-muted leading-relaxed mb-4","children":"Get a feel for a new dataset in seconds by chaining the most common commands:"}],["$","$L20",null,{"title":"Explore a dataset end-to-end","code":"# 1. Preview the data\nstatslibx preview titanic -n 5\n\n# 2. Check data quality\nstatslibx quality titanic\n\n# 3. Descriptive statistics for numeric columns\nstatslibx describe titanic -n\n\n# 4. Profile categorical columns\nstatslibx data titanic -t -m"}],["$","h3",null,{"className":"font-syne text-sm font-semibold text-white mb-3 mt-8","children":"Analyse a local file"}],["$","p",null,{"className":"text-sm text-muted leading-relaxed mb-4","children":"Point the CLI at any CSV or Excel file on your machine:"}],["$","$L20",null,{"title":"Work with a local dataset","code":"# Full description of a local CSV\nstatslibx describe \"./data/sales_2024.csv\"\n\n# Quality report with verbose output\nstatslibx quality \"./data/sales_2024.csv\" -v\n\n# Preview a random sample\nstatslibx preview \"./data/sales_2024.csv\" -n 10 -s"}],["$","h3",null,{"className":"font-syne text-sm font-semibold text-white mb-3 mt-8","children":"Quick comparison"}],["$","p",null,{"className":"text-sm text-muted leading-relaxed mb-4","children":"Compare two built-in datasets side by side:"}],["$","$L20",null,{"title":"Compare datasets","code":"# Iris — balanced numeric dataset\nstatslibx info iris\n\n# Titanic — mixed types with missing values\nstatslibx info titanic -d"}],["$","div",null,{"className":"mt-8 p-4 rounded-xl bg-accent/5 border border-accent/20","children":["$","p",null,{"className":"text-sm text-accent leading-relaxed","children":[["$","strong",null,{"children":"Tip:"}]," Use ",["$","code",null,{"className":"code-inline","children":"statslibx <command> --help"}]," to view the full option list for any command directly in your terminal."]}]}]]}]
