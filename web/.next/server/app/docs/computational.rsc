c:["$","$1","c",{"children":[["$","div",null,{"children":[["$","div",null,{"className":"mb-10 pb-8 border-b border-border","children":[["$","div",null,{"className":"flex items-center gap-3 mb-3","children":[["$","div",null,{"className":"text-accent","children":["$","$L7",null,{"ref":"$undefined","iconNode":[["path",{"d":"M12 20v2","key":"1lh1kg"}],["path",{"d":"M12 2v2","key":"tus03m"}],["path",{"d":"M17 20v2","key":"1rnc9c"}],["path",{"d":"M17 2v2","key":"11trls"}],["path",{"d":"M2 12h2","key":"1t8f8n"}],["path",{"d":"M2 17h2","key":"7oei6x"}],["path",{"d":"M2 7h2","key":"asdhe0"}],["path",{"d":"M20 12h2","key":"1q8mjw"}],["path",{"d":"M20 17h2","key":"1fpfkl"}],["path",{"d":"M20 7h2","key":"1o8tra"}],["path",{"d":"M7 20v2","key":"4gnj0m"}],["path",{"d":"M7 2v2","key":"1i4yhu"}],["rect",{"x":"4","y":"4","width":"16","height":"16","rx":"2","key":"1vbyd7"}],["rect",{"x":"8","y":"8","width":"8","height":"8","rx":"1","key":"z9xiuo"}]],"className":"lucide-cpu w-6 h-6"}]}],["$","h1",null,{"className":"font-syne text-3xl font-extrabold text-white tracking-tight","children":"ComputationalStats"}],["$","span",null,{"className":"font-mono text-xs text-accent bg-accent/10 border border-accent/20 px-2 py-0.5 rounded-full","children":["v","0.4.0"]}]]}],["$","p",null,{"className":"text-muted text-base max-w-2xl leading-relaxed","children":"Computational statistical methods including regression, interpolation, bootstrapping, and clustering algorithms for advanced data analysis."}]]}],["$","section",null,{"className":"mb-12","children":[["$","h2",null,{"className":"section-title","children":"Class Overview"}],["$","div",null,{"className":"class-card","children":[["$","p",null,{"className":"text-sm text-muted leading-relaxed mb-4","children":["The ",["$","code",null,{"className":"code-inline","children":"ComputationalStats"}]," class provides advanced computational statistics methods for regression analysis, interpolation, bootstrapping, and clustering. It is designed for users who need to perform sophisticated statistical computations on their data."]}],["$","div",null,{"className":"border border-border rounded-lg p-4 bg-black/20","children":[["$","p",null,{"className":"text-sm font-mono text-muted mb-1","children":[["$","span",null,{"className":"text-accent","children":"from"}]," statslibx ",["$","span",null,{"className":"text-accent","children":"import"}]," ComputationalStats"]}],["$","p",null,{"className":"text-sm font-mono text-muted","children":"cs = ComputationalStats(data)"}]]}]]}]]}],["$","section",null,{"className":"mb-12","children":[["$","h2",null,{"className":"section-title","children":"Methods"}],["$","div",null,{"className":"space-y-3","children":[["$","$Lf",null,{"name":"regression","signature":"regression(X, y, degree=1, interaction_terms=False)","description":"Fit a polynomial regression model to the data. Supports multiple independent variables, configurable polynomial degree, and optional interaction terms between variables.","parameters":[{"name":"X","type":"str | list of str","description":"Column name(s) for independent variable(s)"},{"name":"y","type":"str","description":"Column name for the dependent variable"},{"name":"degree","type":"int","description":"Degree of the polynomial","default":"1"},{"name":"interaction_terms","type":"bool","description":"Whether to include interaction terms","default":"False"}],"returns":"RegressionResult","example":"# Simple polynomial regression\nresult = cs.regression(\"x\", \"y\", degree=2)\n\n# Multiple regression with interaction terms\nresult = cs.regression([\"x1\", \"x2\"], \"y\", degree=2, interaction_terms=True)\n\n# Get predictions\npredictions = result.predict({\"x1\": [1.0, 2.0], \"x2\": [3.0, 4.0]})"}],["$","$Lf",null,{"name":"linear_regression","signature":"linear_regression(X, y)","description":"Convenience wrapper for fitting a linear regression model (polynomial degree=1). Performs ordinary least squares regression and returns detailed statistics.","parameters":[{"name":"X","type":"str | list of str","description":"Column name(s) for independent variable(s)"},{"name":"y","type":"str","description":"Column name for the dependent variable"}],"returns":"RegressionResult","example":"result = cs.linear_regression(\"x\", \"y\")\nprint(f\"R² = {result.r2}\")\nprint(result.summary())"}],"$L10","$L11","$L12","$L13","$L14","$L15","$L16","$L17","$L18","$L19","$L1a","$L1b","$L1c","$L1d","$L1e","$L1f","$L20"]}]]}],"$L21"]}],null,"$L22"]}]
