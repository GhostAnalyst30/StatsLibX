":"from statslibx import DescriptiveStats, InferentialStats, Report, to_report_data\nimport pandas as pd\n\ndf = pd.DataFrame({\"A\": [1, 2, 3, 4, 5], \"B\": [10, 20, 30, 40, 50]})\nds = DescriptiveStats(df)\npayload = to_report_data(ds.summary())\n\nreport = Report(format=\"html\")\nreport.add_section(payload[\"title\"])\nreport.save(\"full_report.html\")"}],"$L10","$L11"]}]]}],"$L12","$L13"],null,"$L14"]}]
